# Copy this file to .env and fill it in. Never commit .env.

# --- Sending (use a separate outreach domain, not your main one) ---
SMTP_HOST=mail.your-outreach-domain.co.ke
SMTP_PORT=587
SMTP_USER=florence@your-outreach-domain.co.ke
SMTP_PASS=
FROM_NAME=Florence from TalkSasa
# must be on the same domain as SMTP_USER, or SPF/DKIM checks fail and mail lands in spam
FROM_EMAIL=florence@your-outreach-domain.co.ke
# at most 10 a day; a higher DAILY_LIMIT only counts with DAILY_LIMIT_OVERRIDE=true (announced on Telegram every run)
DAILY_LIMIT=10
DAILY_LIMIT_OVERRIDE=false
SEND_DELAY_SECONDS=90
# first emails only go to leads with a need score of at least this (python targeting.py score)
MIN_SCORE=50
# at most this many first emails a day to one industry; spare slots still get used (0 = no cap)
MAX_PER_INDUSTRY=0
# Sending pauses while more than this % of the companies emailed in the last
# BOUNCE_WINDOW_DAYS bounced; it reopens by itself as those sends age out
BOUNCE_LIMIT_PERCENT=3
BOUNCE_WINDOW_DAYS=14
BOUNCE_MIN_SENDS=20
# true = each lead gets two follow-ups with no answer: templates/followup/ FOLLOWUP_AFTER_DAYS
# business days after the first email, then templates/followup2/ FOLLOWUP_AFTER_DAYS business
# days after that. A first email is never sent twice either way.
FOLLOWUPS_APPROVED=false
FOLLOWUP_AFTER_DAYS=5

# --- Reading replies ---
IMAP_HOST=mail.your-outreach-domain.co.ke
# IMAP_USER / IMAP_PASS default to the SMTP ones
POLL_MINUTES=5
# A second Telegram alert for an interested reply nobody has answered after this many hours
STALE_REPLY_HOURS=2

# --- AI: "ollama" (needs ~16GB RAM PC) or "groq" (free API key at console.groq.com) ---
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# false = templates only (no AI opener, first 3 uses from uses.yaml). true = AI writes the opener and picks uses.
USE_AI_OPENER=false
# Groq model that writes openers and picks uses. GROQ_MODEL only labels replies.
# Must be a model your Groq key can use (see console.groq.com/docs/models).
WRITER_MODEL=llama-3.3-70b-versatile

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Shown in emails ---
COMPANY=TalkSasa Communications Ltd
SENDER_NAME=Florence
SENDER_PHONE=+254 762000008
WEBSITE=https://talksasa.com
# Optional link to a company profile. Shown as the last line of the signature when set.
PROFILE_URL=

# --- PDF attached to every email (leave empty for no attachment) ---
ATTACH_PDF=TalkSasa_Overview.pdf

# CRM replies (all optional; each defaults to the SMTP settings above)
# CRM_FROM_EMAIL=sales@talksasa.co.ke
# CRM_SMTP_USER=sales@talksasa.co.ke
# CRM_SMTP_PASS=
# CRM_SENT_FOLDER=Sent
CRM_DRY_RUN=false

# Web search for discover.py: tavily (falls back to DuckDuckGo) or duckduckgo
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_MONTHLY_CAP=900
# Google Places for discover.py: companies on Google Maps, with website and phone. Off when
# empty. Google charges for calls beyond its free allowance; the cap stops them for the month.
GOOGLE_PLACES_API_KEY=
PLACES_MONTHLY_CAP=500

# PostgreSQL instead of the SQLite file DB_PATH: postgresql://user:password@host:5432/dbname
# (copy the data first with: python migrate_to_postgres.py leads.db)
# DATABASE_URL=
